{
  "name": "Guardião 5 Estrelas - Triagem de Avaliações com Notificação",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "avaliador",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "webhook-trigger",
      "name": "Webhook Avaliador"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "rating-condition",
              "leftValue": "={{ $json.body.rating }}",
              "rightValue": 4,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "check-rating",
      "name": "Nota é 4 ou 5?"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"action\": \"redirect_google\",\n  \"google_url\": \"https://maps.google.com\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        -100
      ],
      "id": "response-google-redirect",
      "name": "Retorna URL do Google (4-5 ★)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.exemplo.com/v1/messages/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer SEU_TOKEN_AQUI"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"5511999999999\",\n  \"message\": \"🚨 ALERTA DE AVALIAÇÃO BAIXA DA EMPRESA: \" + $json.body.slug + \"\\n\\n⭐ Nota: \" + $json.body.rating + \" estrelas\\n👤 Cliente: \" + ($json.body.customer_name || 'Anônimo') + \"\\n📞 Telefone: \" + ($json.body.customer_phone || 'Não informado') + \"\\n💬 Feedback: \" + $json.body.feedback\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        520,
        140
      ],
      "id": "notify-manager-http",
      "name": "Notificar Gerente (HTTP Request)"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"action\": \"internal_feedback\",\n  \"status\": \"success\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        760,
        140
      ],
      "id": "response-internal-feedback",
      "name": "Retorna Sucesso Feedback (1-3 ★)"
    }
  ],
  "connections": {
    "Webhook Avaliador": {
      "main": [
        [
          {
            "node": "Nota é 4 ou 5?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Nota é 4 ou 5?": {
      "main": [
        [
          {
            "node": "Retorna URL do Google (4-5 ★)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notificar Gerente (HTTP Request)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notificar Gerente (HTTP Request)": {
      "main": [
        [
          {
            "node": "Retorna Sucesso Feedback (1-3 ★)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
